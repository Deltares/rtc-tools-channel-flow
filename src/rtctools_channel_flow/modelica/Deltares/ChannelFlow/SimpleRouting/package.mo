within Deltares.ChannelFlow;

package SimpleRouting "Simple routing components based on QInPort and QOutPort, i.e. without potential variable"
 annotation (
    Documentation(info="
<html>

<p>
This group of modeling objects contains building blocks to compose water balance models. Interfaces of the building blocks have inflow or outflow, respectively.
</p>

</html>")
  );
end SimpleRouting;
